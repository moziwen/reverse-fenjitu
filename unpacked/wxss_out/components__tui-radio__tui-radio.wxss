.tui-checkbox__input{-webkit-align-items:center;align-items:center;border-radius:50%;box-sizing:border-box;color:transparent;display:-webkit-inline-flex;display:inline-flex;-webkit-flex-shrink:0;flex-shrink:0;font-size:0;height:20px;-webkit-justify-content:center;justify-content:center;overflow:hidden;position:relative;vertical-align:top;width:20px}
.tui-check__mark{border-bottom:3px solid #fff;border-right:3px solid #fff;box-sizing:border-box;height:20px;-webkit-transform:rotate(45deg) scale(.5);transform:rotate(45deg) scale(.5);-webkit-transform-origin:54% 48%;transform-origin:54% 48%;width:10px}
.tui-radio__hidden{-webkit-appearance:none;-moz-appearance:none;appearance:none;border:0;display:inline-block;height:100%;left:0;opacity:0;position:absolute;top:0;width:100%;z-index:2}
.tui-checkbox__disabled{opacity:.6}
