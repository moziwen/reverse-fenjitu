.tui-color__white{background-color:#fff;color:#000}
.tui-new-label-progress{bottom:0px;display:-webkit-inline-flex;display:inline-flex;height:8px;left:0px;opacity:.8;position:absolute;width:100%}
.tui-new-label-text{-webkit-align-items:center;align-items:center;border-radius:12%;display:-webkit-flex;display:flex;height:20px;-webkit-justify-content:center;justify-content:center;position:absolute;right:0px;top:0px;width:30px}
.tui-container-study{box-sizing:border-box;padding:5px;width:100%}
.tui-extend-item{word-wrap:break-word;background:#dfeaf3;border-radius:10px;box-sizing:border-box;color:#fff;font-family:Microsoft YaHei;margin-bottom:15px;margin-left:12px;text-align:justify;word-break:break-all}
.tui-title-study{box-sizing:border-box;color:#fff;font-size:24px;font-weight:500;padding:15px 0;text-align:center;width:100%}
.flex__between{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-justify-content:space-between;justify-content:space-between;width:95%}
.word-mode-title{box-sizing:border-box;color:#888;font-size:15px;font-weight:500;padding:10px;width:100%}
.safearea-bottom{height:60px}
.tui-logo{height:36px;width:36px}
.tui-logo,.tui-logo1{-webkit-flex-shrink:0;flex-shrink:0}
.tui-logo1{height:60px;width:60px}
.pindu_container{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;padding:10px}
.message{color:red;font-size:16px;margin-bottom:10px;opacity:0;transition:opacity .3s}
.message.show{opacity:1}
.input-area{display:-webkit-flex;display:flex;-webkit-flex-wrap:wrap;flex-wrap:wrap;gap:5px;-webkit-justify-content:center;justify-content:center;margin-bottom:20px;margin-top:10px}
.input-area.completed{-webkit-animation:celebrate .5s ease-in-out;animation:celebrate .5s ease-in-out}
@-webkit-keyframes celebrate{0%{opacity:1;-webkit-transform:scale(1);transform:scale(1)}
50%{opacity:.7;-webkit-transform:scale(1.2);transform:scale(1.2)}
100%{opacity:1;-webkit-transform:scale(1);transform:scale(1)}
}@keyframes celebrate{0%{opacity:1;-webkit-transform:scale(1);transform:scale(1)}
50%{opacity:.7;-webkit-transform:scale(1.2);transform:scale(1.2)}
100%{opacity:1;-webkit-transform:scale(1);transform:scale(1)}
}.letter-box{-webkit-align-items:center;align-items:center;border:1px solid #333;box-sizing:border-box;color:#333;display:-webkit-flex;display:flex;font-size:32px;-webkit-justify-content:center;justify-content:center;margin-top:10px;text-align:center}
.letter-box.empty{color:#ccc}
.letter-box.highlight{background-color:#ffeb3b;border-color:#f44336;transition:background-color .3s,border-color .3s}
.letters-area{-webkit-flex-wrap:wrap;flex-wrap:wrap;gap:7.5px;margin-bottom:20px}
.letter-btn,.letters-area{display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center}
.letter-btn{-webkit-align-items:center;align-items:center;background-color:#f0f0f0;border:1px solid #333;border-radius:5px;box-sizing:border-box;font-size:32px;height:60px}
.letter-btn[disabled]{background-color:#ccc;opacity:.5}
.confetti-gif{height:120px;pointer-events:none;position:absolute;width:120px;z-index:5}
.tui-word-container{-webkit-flex-direction:row;flex-direction:row;-webkit-justify-content:space-between;justify-content:space-between;width:100%}
.tui-word-button,.tui-word-container{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;min-height:60px}
.tui-word-button{background-color:#fff;border-radius:10px;box-shadow:0 4px 10px rgba(0,0,0,.08);font-size:28px;-webkit-justify-content:center;justify-content:center;margin:4px;transition:-webkit-transform .1s ease;transition:transform .1s ease;transition:transform .1s ease,-webkit-transform .1s ease;width:50%}
.tui-word-button:active{background-color:#fafafa;box-shadow:0 2px 5px rgba(0,0,0,.05);-webkit-transform:scale(.96);transform:scale(.96)}
.gif-icon{height:31px;width:37px}
.tui-new-label-gif{border-radius:12%;height:32px;left:5px;position:absolute;top:5px;width:38px}
.poster-container,.tui-new-label-gif{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center}
.poster-container{background-color:rgba(0,0,0,.7);-webkit-flex-direction:column;flex-direction:column;height:100vh;left:0;position:fixed;top:0;width:100vw;z-index:9999}
.poster-img{border-radius:8px;box-shadow:0 6px 16px rgba(0,0,0,.3);height:540px;width:300px}
.save-btn{background-color:#ff9800;border-radius:20px;color:#fff;font-size:15px;margin-top:20px;width:200px;z-index:10000}
.hidden-canvas{height:540px;left:-9999px;position:absolute;top:-9999px;width:300px;z-index:-1}
.close-btn{-webkit-align-items:center;align-items:center;background-color:hsla(0,0%,100%,.25);border-radius:50%;color:#fff;display:-webkit-flex;display:flex;font-size:22px;font-weight:300;height:30px;-webkit-justify-content:center;justify-content:center;line-height:1;position:absolute;right:26px;top:25px;width:30px;z-index:10001}
.close-btn:active{background-color:hsla(0,0%,100%,.4)}
.download-icon{height:39px;width:39px}
.tui-new-label-download{-webkit-align-items:center;align-items:center;border-radius:12%;display:-webkit-flex;display:flex;height:45px;-webkit-justify-content:center;justify-content:center;left:3px;position:absolute;top:3px;width:45px}
