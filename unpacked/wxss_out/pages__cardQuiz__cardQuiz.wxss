body{background-color:#f7f7f7}
.container{box-sizing:border-box;padding:10px 0 60px}
.huanhu{position:fixed;right:8px;top:8px}
.icon-huanhu{height:30px;width:30px}
.title-display{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-justify-content:center;justify-content:center}
.icon-yanhua{height:50px;width:50px}
.quiz-volume{margin-top:20px;width:100%;z-index:1}
.quiz-volume,.volume-bg{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;height:54px;-webkit-justify-content:center;justify-content:center}
.volume-bg{background:#5677fc;border-radius:50%;opacity:.7;width:54px}
.volume-icon{height:60px;width:60px;z-index:99}
.header{box-sizing:border-box;padding:40px 45px 30px}
.title{color:#333;font-size:17px;font-weight:500}
.tui-rate-container{-webkit-align-items:center;align-items:center;background:#fff;box-sizing:border-box;display:-webkit-flex;display:flex;font-size:15px;-webkit-justify-content:space-between;justify-content:space-between;margin-left:15px;margin-right:15px;margin-top:15px;padding:20px}
.tui-title{font-size:24px;margin-left:90px}
.banner-item{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column}
.tui-padding{box-sizing:border-box;padding:0 15px}
wx-tui-macaron{color:#ff9b6a}
.bg-macaron{background-color:#ff9b6a;color:var(--black)}
.lines-macaron{color:#ff9b6a}
.tui-icon-red{color:#ff201f}
.tui-radius-all{border-radius:12px;overflow:hidden}
.tui-mtop{margin-top:13px}
.quiz_recorder{bottom:20px;-webkit-justify-content:center;justify-content:center;position:fixed;width:100%}
.quiz_recorder,.tui-pro-titbox{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.tui-pro-titbox{box-sizing:border-box;-webkit-flex-direction:row;flex-direction:row;font-size:16px;font-weight:500;padding:0px 15px;text-align:left}
.tui-addr-item{font-size:18px;font-weight:300;line-height:17px;padding:10px}
.tui-popup-scroll{font-size:13px;height:350px}
.tui-list-cell{-webkit-align-items:center;align-items:center;box-sizing:border-box;display:-webkit-flex;display:flex;font-size:13px;line-height:13px;padding:15px;position:relative;width:100%}
.tui-right{position:absolute;right:15px;top:15px}
.tui-bold{font-weight:700}
.tui-last::after{border-bottom:0!important}
.tui-safearea-bottom{height:env(safe-area-inset-bottom);width:100%}
.tui-modal-custom{text-align:center}
.tui-default{padding:10px 15px}
.tui-modal-custom-text{color:#333;font-size:15px;padding:15px 0 10px}
.tui-slide-image{border-radius:6px;height:290px;top:0}
.tui-new-label-voice{-webkit-align-items:center;align-items:center;border-radius:12%;display:-webkit-flex;display:flex;height:44px;-webkit-justify-content:center;justify-content:center;position:absolute;right:1px;top:1px;width:44px}
.voice-icon{height:41px;width:41px}
.tui-banner-item{-webkit-align-items:center;align-items:center;box-sizing:border-box;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-justify-content:center;justify-content:center;padding:0 10px}
.quiz-title{font-size:24px;padding:10px}
.quiz-title2{font-size:28px;margin-bottom:10px;margin-top:20px;padding:10px 10px 10px 15px}
.tui-content{background-color:#fff;color:#555;font-size:16px;padding:10px 15px 10px 35px}
.confetti-gif{height:120px;pointer-events:none;position:absolute;width:120px;z-index:5}
