.tui-loadmore-none{font-size:12px;line-height:1.5em;margin:1.5em auto;width:50%}
.tui-loadmore-none,.tui-nomore{display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center}
.tui-nomore{height:100%;margin-top:5px;padding-bottom:3px;position:relative;width:100%}
.tui-nomore::before{border-bottom:0.5px solid #e5e5e5;content:" ";left:0;position:absolute;top:9px;-webkit-transform:scaleY(.5);transform:scaleY(.5);width:100%}
.tui-nomore-text{color:#999;font-size:12px;height:18px;line-height:18px;padding:0 9px;z-index:1}
.tui-nomore-dot,.tui-nomore-text{position:relative;text-align:center}
.tui-nomore-dot{-webkit-display:flex;display:flex;-webkit-justify-content:center;justify-content:center;margin-top:5px;padding-bottom:3px}
.tui-nomore-dot::before{border-bottom:0.5px solid #e5e5e5;content:"";left:50%;position:absolute;top:9px;-webkit-transform:scaleY(.5) translateX(-50%);transform:scaleY(.5) translateX(-50%);width:180px}
.tui-dot-text{color:#e5e5e5;font-size:10px;height:18px;line-height:18px;position:relative;text-align:center;-webkit-transform:scale(.8);transform:scale(.8);-webkit-transform-origin:center center;transform-origin:center center;width:25px;z-index:1}
