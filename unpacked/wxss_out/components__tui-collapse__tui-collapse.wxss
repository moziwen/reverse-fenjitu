@font-face{font-family:tuiCollapse;font-style:normal;font-weight:400;src:url(data:application/font-woff;charset=utf-8;base64,) format("woff")}
.tui-collapse-icon{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-family:tuiCollapse!important;font-style:normal}
.tui-icon-arrow:before{content:"\e600"}
.tui-icon-arrow{font-size:16px;margin-top:-8px;position:absolute;right:15px;top:50%;-webkit-transform:rotate(0);transform:rotate(0);-webkit-transform-origin:center center;transform-origin:center center;transition:all .3s}
.tui-arrow-padding{box-sizing:border-box;padding-right:31px}
.tui-icon-active{-webkit-transform:rotate(180deg);transform:rotate(180deg);-webkit-transform-origin:center center;transform-origin:center center}
.tui-header{position:relative;z-index:2}
.tui-collapse-body,.tui-collapse-body_box{overflow:hidden;transition:all .25s}
.tui-collapse-body{position:relative;z-index:1}
.tui-collapse-transform{opacity:0;-webkit-transform:translateY(-40%);transform:translateY(-40%);visibility:hidden}
.tui-collapse-body_show{opacity:1;-webkit-transform:translateY(0);transform:translateY(0);visibility:visible}
.tui-opacity{opacity:.6}
