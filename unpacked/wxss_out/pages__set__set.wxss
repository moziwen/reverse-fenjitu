.tui-set-box{color:#333;padding-bottom:10px}
.avatar-wrapper{border-radius:8px;margin-bottom:40px;margin-top:40px;padding:0;width:56px!important}
.avatar{display:block;height:56px;width:56px}
.container{display:-webkit-flex;display:flex}
.confirm{background-color:#5677fc;width:70px}
.tui-list-cell{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;font-size:15px;padding:12px 15px}
.tui-info-box{font-size:17px}
.tui-avatar{height:70px;margin-right:10px;width:70px}
.tui-item-box{box-sizing:border-box;width:100%}
.tui-item-box,.tui-list-cell_name{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.tui-list-cell_name{-webkit-justify-content:center;justify-content:center;padding-left:10px}
.tui-ml-auto,.tui-right{margin-left:auto}
.tui-right{color:#333;font-size:13px;margin-right:17px}
.tui-logo{-webkit-flex-shrink:0;flex-shrink:0;height:26px;width:26px}
.tui-mtop{margin-top:10px}
.tui-exit{padding:50px 12px}
.tui-line-cell{-webkit-align-items:center;align-items:center;box-sizing:border-box;display:-webkit-flex;display:flex;width:100%}
.tui-input{color:#333;-webkit-flex:1;flex:1;font-size:16px;overflow:visible;padding-left:10px}
.radio-group{-webkit-flex-shrink:0;flex-shrink:0;margin-left:auto;-webkit-transform:scale(.8);transform:scale(.8);-webkit-transform-origin:100% center;transform-origin:100% center}
.tui-radio{display:inline-block;font-size:18px;padding-left:14px;vertical-align:middle}
.tui-title{color:#333;font-size:16px;padding:15px 0 10px}
.tui-flex-box{-webkit-align-items:flex-start;align-items:flex-start;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-flex-wrap:wrap;flex-wrap:wrap;-webkit-justify-content:flex-start;justify-content:flex-start;margin-bottom:13px;width:100%}
.tui-page__hd{box-sizing:border-box;padding:40px;width:100%}
.tui-page__bd{margin-top:20px;padding-bottom:40px}
.tui-page__title{font-size:20px;font-weight:400;text-align:left}
.tui-page__desc{color:#888;font-size:14px;margin-top:10px;text-align:left}
.tui-bottom-scroll{font-size:13px;max-height:60vh;min-height:50vh}
