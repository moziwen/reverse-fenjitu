.tui-progress-box,.tui-progress-text{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center;width:100%}
.tui-progress-text{-webkit-flex-direction:column;flex-direction:column;height:130px;left:0;padding-top:20px;position:absolute;top:0}
.tui-progress-num{font-size:30px;padding-top:10px}
.tui-charts-box{box-sizing:border-box;padding:0 15px 0 25px;width:100%}
.tui-icon{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;display:block;font-family:rateFont!important;font-style:normal}
.tui-relative{position:relative}
.tui-icon-main{height:100%;left:0;overflow:hidden;position:absolute;top:0}
.tui-icon-collection-fill:before{content:"\e6ea"}
.tui-icon-collection:before{content:"\e6eb"}
.metric-row{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:space-between;justify-content:space-between;padding:5px 0;width:100%}
.metric-label{color:#5c6b73;font-size:16px;font-weight:500;width:31%}
.metric-value-box{-webkit-flex-direction:row;flex-direction:row;gap:2px}
.metric-value-box,.stars-box{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.stars-box{gap:6px;width:44%}
.star-icon{display:inline-block;font-size:26px;line-height:1}
.raw-data-text{color:#a0aec0;font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;line-height:1.2;padding-right:2px;width:25%}
.reward-card{background:#fff;-webkit-flex-direction:column;flex-direction:column;overflow:hidden;padding:20px;position:relative;width:100%}
.badge-wrapper,.reward-card{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.badge-wrapper{background:linear-gradient(135deg,#fff6e0,#ffe099);border-radius:50%;box-shadow:0 8px 16px rgba(255,197,66,.2);height:70px;-webkit-justify-content:center;justify-content:center;margin-bottom:10px;width:70px}
.badge-emoji{font-size:40px}
.card-title{color:#2c3e50;font-size:20px;font-weight:700;letter-spacing:1px;margin-bottom:15px}
.divider{background:#f0f3f7;height:1px;margin:5px 0;width:90%}
.metrics-area{display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;gap:20px;padding:10px 5px;width:100%}
.tui-popup-speak{box-sizing:border-box;height:50vh}
.empty-star{color:#e0e6ed}
.active-star{color:#ffbe1a;display:inline-block;text-shadow:0 2px 8px rgba(255,190,26,.4)}
