.tui-banner-item{-webkit-align-items:center;align-items:center;box-sizing:border-box;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-justify-content:center;justify-content:center;margin-top:10px}
.tui-card{position:relative}
.tui-slide-image{border-radius:9px;display:block;height:60vh;transition:all .05s linear;width:100%}
.tui-word-title{-webkit-flex-direction:row;flex-direction:row;-webkit-justify-content:center;justify-content:center;min-height:50px;padding:10px;width:100%}
.tui-pro-titbox-describe,.tui-word-title{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex}
.tui-pro-titbox-describe{font-size:36px}
.tui-button-bottom{-webkit-align-items:center;align-items:center;bottom:0px;display:-webkit-flex;display:flex;height:90px;-webkit-justify-content:center;justify-content:center;position:relative;width:100%;z-index:99}
.bottom-icon-speak{height:69px;margin:12px;width:69px;z-index:999}
.tui-new-label-index{background:#f0f0f0;border-radius:12%;height:30px;left:0px;opacity:.7}
.tui-new-label-index,.tui-new-label-voice{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center;position:absolute;top:0px;width:45px}
.tui-new-label-voice{height:45px;right:0px}
.voice-icon{height:30px;width:30px}
.popup-recording-start{background-color:rgba(0,0,0,.2)}
.popup-recording-end,.popup-recording-start{-webkit-align-items:center;align-items:center;bottom:0;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;height:100vh;-webkit-justify-content:center;justify-content:center;left:0;position:fixed;right:0;top:0;width:100vw;z-index:10000}
.popup-recording-end{background-color:rgba(0,0,0,.6)}
.icon-recording{height:180px;opacity:.9;width:180px}
.popup-text{color:#fff;-webkit-flex-direction:column;flex-direction:column;height:200px;width:80vw}
.popup-text,.value-container{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center}
.value-container{position:relative}
.confetti-gif{height:120px;left:50%;pointer-events:none;position:absolute;top:50%;-webkit-transform:translate(-50%,-50%);transform:translate(-50%,-50%);width:120px;z-index:5}
.result-text{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;height:100px;-webkit-justify-content:center;justify-content:center;width:80vw}
.value-font{font-family:Times New Roman,Times,serif;font-size:150px;font-style:italic;font-weight:700}
.summary-desc{color:#999;font-size:12px;margin-top:8px}
.stars{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-flex-shrink:0;flex-shrink:0;font-size:13px;gap:1px;white-space:nowrap}
.star-active,.star-empty{display:inline-block;margin-right:1px}
.star-active{color:#ff9b6a}
.star-empty{color:#ddd}
.audio-btn{-webkit-align-items:center;align-items:center;background:#fff2bd;border-radius:50%;box-sizing:border-box;display:-webkit-flex;display:flex;-webkit-flex:0 0 30px;flex:0 0 30px;-webkit-flex-direction:row;flex-direction:row;height:30px;-webkit-justify-content:center;justify-content:center;margin-left:8px;width:30px}
.audio-icon{color:#4d4430;font-size:14px;margin-left:1.5px}
.audio-btn:active{-webkit-transform:scale(.94);transform:scale(.94)}
