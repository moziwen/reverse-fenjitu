.tui-page__hd{box-sizing:border-box;margin-bottom:10px;padding:10px;width:100%}
.tui-page__title{font-size:20px;font-weight:400;text-align:left}
.tui-page__desc{color:#888;font-size:13px;margin-top:15px;text-align:left}
.tui-desc{color:#5c5555;font-size:14px;padding:5px 0;text-align:left}
.tui-container,.tui-desc{box-sizing:border-box;width:100%}
.tui-container{display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;-webkit-justify-content:center;justify-content:center;padding:15px}
.tui-extend-box{-webkit-flex:1;flex:1;margin-right:5px}
.tui-extend-box:last-child{margin-right:0}
.text-between{display:-webkit-flex;display:flex;-webkit-flex-direction:row;flex-direction:row;-webkit-justify-content:space-between;justify-content:space-between;width:90%}
.tui-extend-item{word-wrap:break-word;background:#dfeaf3;border-radius:10px;box-shadow:0 3px 8px 1px rgba(0,0,0,.15);box-sizing:border-box;color:#fff;font-family:Microsoft YaHei;margin-bottom:10px;padding:15px 10px;position:relative;text-align:justify;width:100%;word-break:break-all}
.title-area{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:space-between;justify-content:space-between;position:relative;z-index:10}
.tui-title{font-weight:200;font-weight:600;padding:15px 0;text-align:center;width:100%}
.tui-sub-title,.tui-title{box-sizing:border-box;color:#36454f;font-size:19px}
.tui-sub-title{padding:10px 8px;position:relative;text-align:left;z-index:10}
.task-area{margin-bottom:15px;min-height:50px;z-index:999}
.tui-footer{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:space-between;justify-content:space-between;width:100%}
.tag-item{box-sizing:border-box;-webkit-flex:0 0 50%;flex:0 0 50%}
.icon-item,.tag-item{display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center}
.icon-item{-webkit-align-items:center;align-items:center;-webkit-flex:1;flex:1}
.share-btn{line-height:normal;width:auto!important}
.tui-modal-custom{text-align:center}
.tui-modal-input{border-bottom:0.5px solid #e6e6e6;font-size:16px;margin:15px auto 25px;width:80%}
.tui-hidden-input{width:0}
