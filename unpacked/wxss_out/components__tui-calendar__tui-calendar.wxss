@font-face{font-family:tuiDateFont;font-style:normal;font-weight:400;src:url(data:application/font-woff;charset=utf-8;base64,) format("woff")}
.tui-iconfont{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-family:tuiDateFont!important;font-size:18px;font-style:normal}
.tui-font-close:before{content:"\e608"}
.tui-font-check:before{content:"\e6e1"}
.tui-font-arrowright:before{content:"\e600"}
.tui-font-arrowleft:before{content:"\e601"}
.tui-date-box{-webkit-align-items:center;align-items:center;background-color:#fff;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center;padding:10px 0 15px;width:100%}
.tui-calendar-radius{border-top-left-radius:10px;border-top-right-radius:10px;overflow:hidden}
.tui-date_time{color:#333;font-size:16px;font-weight:700;line-height:16px;padding:0 8px}
.tui-font-arrowleft{margin-right:16px}
.tui-font-arrowright{margin-left:16px}
.tui-date-header{-webkit-align-items:center;align-items:center;box-shadow:0 7.5px 10px -7.5px #efefef;color:#555;font-size:12px;line-height:12px;z-index:2}
.tui-date-content,.tui-date-header{background-color:#fff;display:-webkit-flex;display:flex;position:relative;width:100%}
.tui-date-content{box-sizing:border-box;-webkit-flex-wrap:wrap;flex-wrap:wrap;padding:6px 0}
.tui-flex-start{-webkit-align-content:flex-start;align-content:flex-start}
.tui-bg-month{color:#f5f5f7;font-size:130px;left:50%;line-height:130px;position:absolute;top:50%;-webkit-transform:translate(-50%,-50%);transform:translate(-50%,-50%);z-index:1}
.tui-date{-webkit-align-items:center;align-items:center;display:-webkit-flex;display:flex;-webkit-justify-content:center;justify-content:center;overflow:hidden;padding:6px 0;position:relative;transition:all liner 1.1s;width:14.2857%;z-index:2}
.tui-date-pd_0{padding:0!important}
.tui-start-date{border-bottom-left-radius:4px;border-top-left-radius:4px}
.tui-end-date{border-bottom-right-radius:4px;border-top-right-radius:4px}
.tui-date-text{-webkit-align-items:center;align-items:center;border-radius:50%;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;font-size:16px;height:40px;-webkit-justify-content:center;justify-content:center;line-height:16px;position:relative;width:40px}
.tui-opacity{opacity:.5}
.tui-bottom-popup{bottom:0;left:0;min-height:10px;position:fixed;right:0;-webkit-transform:translate3d(0,100%,0);transform:translate3d(0,100%,0);-webkit-transform-origin:center;transform-origin:center;transition:all .3s ease-in-out;visibility:hidden;width:100%;z-index:9999}
.tui-popup-show{-webkit-transform:translate3d(0,0,0);transform:translate3d(0,0,0);visibility:visible}
.tui-popup-mask{background:rgba(0,0,0,.6);bottom:0;left:0;opacity:0;position:fixed;right:0;top:0;transition:all .3s ease-in-out;visibility:hidden;z-index:9996}
.tui-mask-show{opacity:1;visibility:visible}
.tui-calendar-header{-webkit-align-items:center;align-items:center;background-color:#fff;box-sizing:border-box;color:#555;display:-webkit-flex;display:flex;font-size:15px;height:40px;-webkit-justify-content:center;justify-content:center;padding:0 20px;position:relative;width:100%}
.tui-font-close{color:#999;position:absolute;right:15px;top:50%;-webkit-transform:translateY(-50%);transform:translateY(-50%)}
.tui-btn-calendar{box-sizing:border-box;padding:8px;text-align:center;text-decoration:none}
.tui-font-check{color:#fff;font-size:27px;line-height:27px}
.tui-custom-desc{font-size:12px;line-height:12px;text-align:center;-webkit-transform:scale(.8);transform:scale(.8);-webkit-transform-origin:center center;transform-origin:center center;width:100%}
.tui-date-desc,.tui-lunar-unshow{bottom:4px;left:0;position:absolute;z-index:2}
.tui-date-desc{font-size:12px;line-height:12px;text-align:center;-webkit-transform:scale(.8);transform:scale(.8);-webkit-transform-origin:center center;transform-origin:center center;width:100%}
.tui-calendar-op{-webkit-align-items:center;align-items:center;background-color:#fff;box-sizing:border-box;color:#666;display:-webkit-flex;display:flex;-webkit-flex-direction:column;flex-direction:column;font-size:12px;-webkit-justify-content:center;justify-content:center;padding:0 21px 15px;width:100%}
.tui-calendar-result{height:24px;-webkit-transform:scale(.9);transform:scale(.9);-webkit-transform-origin:center 100%;transform-origin:center 100%}
.tui-calendar-btn_box{width:100%}
