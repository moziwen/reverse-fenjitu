.tui-tag{-webkit-align-items:center;align-items:center;border-radius:3px;display:-webkit-flex;display:flex;-webkit-flex-shrink:0;flex-shrink:0;-webkit-justify-content:center;justify-content:center}
.tui-tag-outline{background-color:none;color:#5677fc;position:relative}
.tui-tag-outline::after{border-radius:6px;-webkit-box-sizing:border-box;box-sizing:border-box;content:"";height:200%;left:0;position:absolute;top:0;-webkit-transform:scale(.5,.5);transform:scale(.5,.5);-webkit-transform-origin:0 0;transform-origin:0 0;width:200%}
.tui-tag-fillet{border-radius:25px}
.tui-tag-outline-fillet::after,.tui-white.tui-tag-fillet::after{border-radius:40px}
.tui-tag-fillet-left{border-radius:25px 0 0 25px}
.tui-tag-fillet-right{border-radius:0 25px 25px 0}
.tui-tag-fillet-left.tui-tag-outline::after{border-radius:50px 0 0 50px}
.tui-tag-fillet-right.tui-tag-outline::after{border-radius:0 50px 50px 0}
.tui-origin-left{-webkit-transform-origin:0 center;transform-origin:0 center}
.tui-origin-right{-webkit-transform-origin:100% center;transform-origin:100% center}
.tui-tag-opcity{opacity:.5}
