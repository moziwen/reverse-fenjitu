.tui-bottom-popup{bottom:0;left:0;min-height:10px;opacity:0;position:fixed;right:0;-webkit-transform:translate3d(0,100%,0);transform:translate3d(0,100%,0);-webkit-transform-origin:center;transform-origin:center;transition:all .3s ease-in-out;width:100%}
.tui-popup-radius{border-top-left-radius:12px;border-top-right-radius:12px;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}
.tui-popup-show{opacity:1}
.tui-popup-mask{background-color:rgba(0,0,0,.6);bottom:0;left:0;opacity:0;position:fixed;right:0;top:0;transition:all .3s ease-in-out;visibility:hidden}
.tui-mask-show{opacity:1;visibility:visible}
