body{background:#fff;color:#333}
.container{box-sizing:border-box;padding:0 15px 15px}
.tui-searchbox{padding:15px 0}
.tui-search-input,.tui-searchbox{-webkit-align-items:center;align-items:center;box-sizing:border-box;display:-webkit-flex;display:flex}
.tui-search-input{background:#f2f2f2;border-radius:17.5px;-webkit-flex-wrap:nowrap;flex-wrap:nowrap;height:33px;padding:0 15px;width:100%}
.tui-input{color:#333;-webkit-flex:1;flex:1;font-size:14px;padding:0 8px}
.tui-input-plholder{color:#b2b2b2;font-size:14px}
.tui-confirm{color:#ff9b6a;-webkit-flex-shrink:0;flex-shrink:0;font-size:16px;padding-left:15px}
.tui-rate-container{-webkit-align-items:center;align-items:center;background:#fff;box-sizing:border-box;display:-webkit-flex;display:flex;font-size:15px;-webkit-justify-content:space-between;justify-content:space-between;margin-left:15px;margin-right:15px;padding:10px}
.tui-title{box-sizing:border-box;font-size:14px;font-weight:300;padding:5px 0;text-align:center;width:100%}
